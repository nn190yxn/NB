APP_ORIGIN=http://localhost:5173
API_PROXY_TARGET=http://localhost:3001
PORT=3001
NODE_ENV=development
DATA_FILE=./server/data.json

# Optional production MySQL storage configuration.
PROJECT_DB_HOST=127.0.0.1
PROJECT_DB_PORT=3306
PROJECT_DB_NAME=content_ip_workbench
PROJECT_DB_USER=content_ip_app
PROJECT_DB_PASSWORD=
PROJECT_DB_CONNECTION_LIMIT=5
PROJECT_DB_BACKUP_DIR=./backups

# API protection defaults; health checks are excluded from this limit.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Optional project-owned RedFox configuration.
REDFOX_API_URL=
PROJECT_REDFOX_API_KEY=replace-with-project-key
