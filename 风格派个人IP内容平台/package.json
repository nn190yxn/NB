{
  "name": "content-ip-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:backup": "bash scripts/backup-mysql.sh",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test server/*.test.mjs desktop/*.test.mjs",
    "e2e": "node --test server/auth.test.mjs",
    "verify": "npm test && npm run typecheck && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-legacy": "latest"
  }
}
